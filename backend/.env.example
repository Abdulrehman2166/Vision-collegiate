# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection string (get from Project Settings → Database)
# ⚠️ PASSWORD MUST BE URL-ENCODED: space → %20, @ → %40, # → %23, etc.
DATABASE_URL=postgresql://postgres:[YOUR-URL-ENCODED-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# ⚠️ PRODUCTION: Use a long random string (>= 64 chars). Generate with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Add your Vercel/Netlify/custom domains.
# Example: https://vision-collegiate.vercel.app,https://app.yourdomain.com
CORS_ORIGIN=https://vision-collegiate.vercel.app,http://localhost:3001

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Get from Supabase Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=reports

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Get from developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
